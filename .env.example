# Database Configuration (MySQL / MariaDB)
DATABASE_URL="mysql://root:password@localhost:3306/kollimalai"

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Authentication Secrets
AUTH_SECRET="your-nextauth-secret-min-32-chars"
JWT_ACCESS_SECRET="your-jwt-access-secret"
JWT_REFRESH_SECRET="your-jwt-refresh-secret"
JWT_RESET_PASSWORD_SECRET="your-jwt-reset-password-secret"

# Hostinger Business Email (SMTP)
# Documentation: https://www.hostinger.com/support/4305847-set-up-hostinger-email-on-your-applications-and-devices/
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@kollimalaiarasan.com
SMTP_PASS=
MAIL_FROM="Kollimalai Arasan <info@kollimalaiarasan.com>"

# Optional Backward-Compatible Email Aliases (mapped to SMTP_* automatically)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USER=info@kollimalaiarasan.com
EMAIL_PASS=
EMAIL_FROM=info@kollimalaiarasan.com

# Google OAuth Credentials (Optional)
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Payment Gateway App URL
PAYMENT_APP_URL=http://localhost:3001

# Invoice Configuration
# Set start date for new official WEB/YY-YY/XXXX series.
# Historical orders placed before this date preserve their legacy order numbers as invoice numbers.
INVOICE_SERIES_START_DATE="2026-10-24T00:00:00.000Z"
INVOICE_SERIES_PREFIX="WEB"

# Shiprocket Multi-Carrier Integration
SHIPROCKET_EMAIL="your-shiprocket-account-email@example.com"
SHIPROCKET_PASSWORD="your-shiprocket-password"
SHIPROCKET_PICKUP_LOCATION="Primary"
SHIPROCKET_PICKUP_PINCODE="637411"
SHIPROCKET_TEST_MODE="false"
SHIPROCKET_WEBHOOK_TOKEN="optional-webhook-secret-token"
SHIPROCKET_LOCAL_TRACKING_SIMULATION="false"

